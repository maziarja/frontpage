
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth Models ───────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  feeds       Feed[]
  categories  Category[]
  readStates  ReadState[]
  bookmarks   Bookmark[]
  preferences UserPreference?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── App Models ───────────────────────────────────────────────────────────────

enum FeedHealthStatus {
  ACTIVE
  STALE
  ERROR
}

model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  order  Int    @default(0)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeds Feed[]
}

model Feed {
  id            String           @id @default(cuid())
  userId        String
  url           String
  title         String
  description   String?
  faviconUrl    String?
  categoryId    String?
  healthStatus  FeedHealthStatus @default(ACTIVE)
  lastFetchedAt DateTime?
  errorMessage  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    FeedItem[]
}

model FeedItem {
  id          String    @id @default(cuid())
  feedId      String
  url         String
  title       String
  description String?
  content     String?   @db.Text
  author      String?
  publishedAt DateTime?
  guid        String
  summary     String?   @db.Text
  tags        String[]
  createdAt   DateTime  @default(now())

  feed       Feed        @relation(fields: [feedId], references: [id], onDelete: Cascade)
  readStates ReadState[]
  bookmarks  Bookmark[]

  @@unique([feedId, guid])
  @@index([feedId, publishedAt])
}

model ReadState {
  userId     String
  feedItemId String
  readAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItem FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)

  @@id([userId, feedItemId])
  @@index([userId])
}

model Bookmark {
  userId     String
  feedItemId String
  savedAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedItem FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)

  @@id([userId, feedItemId])
  @@index([userId])
}

enum Layout {
  COMPACT
  STANDARD
  CARD
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

model UserPreference {
  userId          String @id
  layout          Layout @default(STANDARD)
  refreshInterval Int    @default(30)
  theme           Theme  @default(SYSTEM)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
